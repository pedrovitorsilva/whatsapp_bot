    {
      "id": "4b398795-36df-57a5-ad89-77e2db82193f",
      "name": "Code: montar aviso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        100
      ],
      "parameters": {
        "jsCode": "// cabeçalhos e valores da planilha: 'Data de Referência' -> 'data_de_referência'\nconst norm = s => String(s ?? '').trim().toLowerCase().replace(/ /g, '_');\nconst rows = n => $(n).all().map(i => Object.fromEntries(Object.entries(i.json).map(([k, v]) => [norm(k), v])));\n// data do Sheets: '26/09/2026' (formatada) ou serial numérico -> '2026-09-26'\nconst iso = v => typeof v === 'number' ? DateTime.fromISO('1899-12-30').plus({ days: v }).toISODate()\n                                       : String(v ?? '').trim().split('/').reverse().join('-');\nconst preencher = (t, vars) => t.replace(/\\{\\{([^}]+)\\}\\}/g, (m, k) => vars[k.trim()] ?? m);\nconst msg = t => rows('Mensagens').find(m => norm(m.tipo) === t).mensagem;\nconst tr = rows('Trocas').filter(t => norm(t.status) === 'aprovada');\nconst efetivo = (nome, dia) => tr.find(t => t.pessoa_original === nome && iso(t['data_de_referência']) === dia)?.pessoa_substituta ?? nome;\n\nconst pessoas = rows('Pessoas');\nconst env = rows('Envios');\n\nconst semanal = $('Trigger semanal').isExecuted;                 // qual cron disparou\nconst tipo = semanal ? 'semanal' : 'lembrete';\nconst hoje = $now.toISODate(), limite = $now.plus({ days: 6 }).toISODate();\n\n// próximo culto nos próximos 7 dias\nconst esc = rows('Escalas').map(e => ({ ...e, dia: iso(e.data) })).filter(e => e.dia >= hoje && e.dia <= limite);\nif (!esc.length) return [];\nconst dia = esc.map(e => e.dia).sort()[0];\n\nconst chave = semanal ? dia : hoje;                              // semanal: 1 por culto; lembrete: 1 por dia\nif (env.some(x => norm(x.tipo) === tipo && iso(x['data_de_referência']) === chave)) return [];\n\nconst efet = esc.filter(e => e.dia === dia).map(e => ({ nome: efetivo(e.nome, dia), funcao: String(e['função'] ?? '').trim() }));\nconst fone = nome => String(pessoas.find(p => p.nome === nome)?.telefone ?? '').replace(/\\D/g, '');\nconst mentions = [];\nconst marca = e => {\n  const n = fone(e.nome);\n  if (n) mentions.push(n + '@c.us');\n  return n ? '@' + n : e.nome;                                   // sem telefone: só o nome\n};\nconst grupo = f => efet.filter(e => e.funcao === f).map(marca).join(', ');\nconst lista = efet.map(marca).join(', ');\n\nconst texto = preencher(msg(tipo), {\n  data: dia.split('-').reverse().slice(0, 2).join('/'), lista,\n  'Lideranças': grupo('Liderança'), Volantes: grupo('Volante'), Membros: grupo('Membro'),\n});\nreturn [{ json: { tipo, data_referencia: chave, status: 'ENVIANDO', criado_em: $now.toISO(),\n                  texto, mentions: [...new Set(mentions)] } }];\n"
      }
    },
